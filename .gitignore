# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
.pytest_cache/
.ruff_cache/

# Fake Home Assistant runtime (generated by scripts/develop). Ignore everything
# under config/ except the tracked bootstrap configuration.yaml - this directory
# ends up holding the real Joulo API token (config/.storage/core.config_entries)
# plus logs/db/lock/version files, and new HA releases keep adding more of these,
# so a whitelist is safer than trying to keep enumerating them one by one.
config/*
!config/configuration.yaml

# Secrets (e.g. a real Joulo API token dropped in for manual devcontainer testing)
.env

# Editor / OS
.DS_Store
Thumbs.db
.idea/

# Claude Code local state (machine-specific, not shared)
.claude/
